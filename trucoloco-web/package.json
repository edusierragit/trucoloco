{
  "name": "trucoloco-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mcp": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/dev-with-threejs-mcp.ps1",
    "mcp:three": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/start-threejs-mcp.ps1",
    "check:rules": "node scripts/validate-truco-rules.mjs",
    "check:flow": "node scripts/validate-truco-flow.mjs",
    "check:ui": "node scripts/validate-ui-flow.mjs",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "build": "vite build .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "postprocessing": "^6.39.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.183.2",
    "trystero": "^0.25.2",
    "vite": "^8.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "threejs-devtools-mcp": "^0.4.1"
  }
}
